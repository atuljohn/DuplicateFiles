<UserControl x:Class="DuplicatePhotoFinder.Views.ScanProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <!-- Three-row grid: main content at top (fixed position), spacer, filename at bottom.
         Filename row is Auto-height so it grows VERTICALLY with wrapped text, but never
         pushes the main content above it (the * spacer absorbs the growth). Both regions
         are MaxWidth-capped so horizontal width is stable regardless of filename length. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Main content — anchored to top, never moves -->
        <StackPanel Grid.Row="0" MaxWidth="600" HorizontalAlignment="Center" Margin="40,40,40,0">

            <TextBlock Text="Scanning..." Style="{StaticResource HeadingText}" Margin="0,0,0,24" />

            <TextBlock Text="{Binding ScanProgress.Phase}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="14" Margin="0,0,0,8" />

            <ProgressBar Value="{Binding ScanProgress.ProgressPercent}"
                         Minimum="0" Maximum="100"
                         Height="10" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <!-- During phase 1 (file scan) total is 0 — show indeterminate activity. -->
                            <DataTrigger Binding="{Binding ScanProgress.TotalFiles}" Value="0">
                                <Setter Property="IsIndeterminate" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding ScanProgress.FilesProcessed, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding ScanProgress.TotalFiles, Mode=OneWay}" />
                    <Run Text=" files" />
                </TextBlock>
                <TextBlock Grid.Column="1" Foreground="{StaticResource AccentBrush}">
                    <Run Text="{Binding ScanProgress.ProgressPercent, StringFormat='{}{0:F0}%', Mode=OneWay}" />
                </TextBlock>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                    <Run Text="Elapsed: " />
                    <Run Text="{Binding ScanProgress.ElapsedTime, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock Grid.Column="2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                    <Run Text="Est. remaining: " />
                    <Run Text="{Binding ScanProgress.EstimatedRemainingTime, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                </TextBlock>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16" Height="50">
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center">
                    <Run Text="Duplicate groups found: " />
                    <Run Text="{Binding ScanProgress.GroupsFound, Mode=OneWay}"
                         Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                </TextBlock>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding PauseButtonText}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding TogglePauseCommand}"
                        MinWidth="90" Margin="0,0,8,0" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelScanCommand}" />
            </StackPanel>

        </StackPanel>

        <!-- Row 2: Current file — anchored at bottom, grows vertically as text wraps,
             fixed MaxWidth so horizontal never changes. Nothing else moves when it grows. -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                Padding="14" Margin="40,16,40,40"
                MaxWidth="600" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="CURRENT FILE" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ScanProgress.CurrentFile}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
