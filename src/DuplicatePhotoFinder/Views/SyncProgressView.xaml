<UserControl x:Class="DuplicatePhotoFinder.Views.SyncProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <!-- Three-row grid: same layout as ScanProgressView. Main content is anchored to top,
         filename to bottom, spacer between. Filename row grows vertically without disturbing
         the main content above. Both regions are MaxWidth-capped for horizontal stability. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Main content — anchored to top, never moves -->
        <StackPanel Grid.Row="0" MaxWidth="560" HorizontalAlignment="Center" Margin="40,40,40,0">

            <TextBlock Text="Folder Sync"
                       Style="{StaticResource HeadingText}"
                       FontSize="26" HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="{Binding Sync.Phase}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="15" HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <ProgressBar Height="10"
                         Minimum="0"
                         Maximum="{Binding Sync.TotalFiles}"
                         Value="{Binding Sync.ProcessedFiles}"
                         Margin="0,0,0,12">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <!-- Before the plan is built, total is 0 — show indeterminate activity. -->
                            <DataTrigger Binding="{Binding Sync.TotalFiles}" Value="0">
                                <Setter Property="IsIndeterminate" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Sync.ProcessedFiles}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="files processed" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Sync.TotalFiles}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="total files" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Sync.BytesTransferredDisplay}" Foreground="{StaticResource SuccessBrush}"
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="transferred" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{Binding Sync.PauseButtonText}" Style="{StaticResource SecondaryButton}"
                        Padding="24,10" MinWidth="100" Margin="0,0,12,0"
                        Command="{Binding Sync.TogglePauseCommand}" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Padding="24,10"
                        Command="{Binding Sync.CancelCommand}" />
            </StackPanel>

        </StackPanel>

        <!-- Row 2: Current file — anchored at bottom, grows vertically as text wraps,
             fixed MaxWidth so horizontal never changes. Nothing else moves when it grows. -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                Padding="14" Margin="40,16,40,40"
                MaxWidth="560" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="CURRENT FILE" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Sync.CurrentFile}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
